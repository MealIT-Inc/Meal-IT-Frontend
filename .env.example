# Copy this file to .env.local and fill in your values. NEVER commit real secrets.

# Firebase Web SDK (public config — safe to expose but keep in env for convenience)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# If you plan to use Firebase Admin SDK on a server, store the service account JSON
# in a secure secret store (do NOT put it in .env.local). Example: FIREBASE_ADMIN_SERVICE_ACCOUNT
# For local testing, you can point to a file path but ensure it's ignored by git
# FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Other secrets (example)
# NEXTAUTH_SECRET=some-long-secret-if-you-use-nextauth
# DATABASE_URL=postgres://user:pass@host:5432/dbname
